# ===================================================================
# THƯ VIỆN UTH (ULMS) - CỔNG SINH VIÊN (FRONTEND-STUDENT)
# File mẫu cấu hình biến môi trường (Environment Variables Example)
# Sao chép file này thành .env hoặc .env.local và điền các giá trị thực tế
# ===================================================================

# 1. Backend REST API URL (Spring Boot)
VITE_API_BASE_URL=http://localhost:8080/api

# 2. Google Gemini API Key (Dùng cho Trợ lý ảo Chatbot AI & Tìm kiếm thông minh Semantic Search)
# Lấy API Key tại: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 3. Google Maps API Key (Dùng cho hiển thị bản đồ & dẫn đường 3 cơ sở đào tạo UTH)
# Lấy API Key tại: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_MAP_API_KEY=your_google_maps_api_key_here
